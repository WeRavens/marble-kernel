# Marble (POCO F5) KMI-safe Performance Optimization Fragment
# Target: Evolution X 12.2 (Android 17) / Linux 5.10.269 GKI

# Prevent newer Clang warnings from failing the build
# CONFIG_WERROR is not set

# Compiler optimization for performance
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y

# TCP BBR congestion control + Fair Queueing
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y

# ZRAM & Compression
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# Reduce non-essential debug overhead while keeping KMI/GKI stability intact
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set

# Explicitly keep KMI & GKI compatibility options enabled (match stock strict CFI)
CONFIG_KPROBES=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_MODVERSIONS=y
CONFIG_CFI_CLANG=y
